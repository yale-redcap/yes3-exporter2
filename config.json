    "system-settings": [
        {
            "key":   "system-cron-header",
            "type" : "descriptive",
            "name":  "<h5>YES3 Exporter II CRON JOB</h5><p>The YES3 Exporter II perfoms a number daily tasks for each project. By default all of the daily tasks are run at 11 minutes past midnight, but you may specify a different time to run these tasks.</p>"
        },
        {
            "key": "cron-time",
            "name": "Time to run all daily tasks (hh:mm)",
            "type": "dropdown",
            "choices": [
                {"name":"00:11","value":"00:11:00"},
                {"name":"01:11","value":"01:11:00"},
                {"name":"02:11","value":"02:11:00"},
                {"name":"03:11","value":"03:11:00"},
                {"name":"04:11","value":"04:11:00"},
                {"name":"05:11","value":"05:11:00"},
                {"name":"06:11","value":"06:11:00"},
                {"name":"07:11","value":"07:11:00"},
                {"name":"08:11","value":"08:11:00"},
                {"name":"09:11","value":"09:11:00"},
                {"name":"10:11","value":"10:11:00"},
                {"name":"11:11","value":"11:11:00"},
                {"name":"12:11","value":"12:11:00"},
                {"name":"13:11","value":"13:11:00"},
                {"name":"14:11","value":"14:11:00"},
                {"name":"15:11","value":"15:11:00"},
                {"name":"16:11","value":"16:11:00"},
                {"name":"17:11","value":"17:11:00"},
                {"name":"18:11","value":"18:11:00"},
                {"name":"19:11","value":"19:11:00"},
                {"name":"20:11","value":"20:11:00"},
                {"name":"21:11","value":"21:11:00"},
                {"name":"22:11","value":"22:11:00"},
                {"name":"23:11","value":"23:11:00"}
            ],
            "required": false
        },
        {
            "key": "cron-ran-at",
            "name": "The cron job was last run at",
            "type": "text",
            "required": false
        },
        {
            "key": "cron-log",
            "name": "Most recent cron log entry",
            "type": "textarea",
            "required": false
        }
    ],

    "project-settings": [
        {
            "key": "email-notifications-header",
            "type" : "descriptive",
            "name": "<h5>DAILY EMAIL NOTIFICATIONS</h5><p>You may elect to receive daily summaries of YES3 Exporter II actions by email.</p>"
        },
        {
            "key": "notification-email-enable",
            "name": "Enable email notifications",
            "type": "checkbox",
            "required": false
        },
        {
            "key": "notification-email",
            "name": "Email address for notifications. THIS SETTING IS DEPRECATED. You should use the <strong>cron user</strong> setting, below, to identify the email log recipient.",
            "type": "email",
            "required": false,
            "branchingLogic": {
                "conditions": [
                    {
                        "field": "notification-email-enable",
                        "value": 1       
                    }
                ]
            }
        },
        {
            "key": "notification-email-ran-at",
            "name": "Time email notifications were last sent succesfully",
            "type": "text",
            "required": false,
            "super-users-only": true,
            "branchingLogic": {
                "conditions": [
                    {
                        "field": "notification-email-enable",
                        "value": 1    
                    }
                ]
            }
        },
        {
            "key": "toast-the-host",
            "type" : "descriptive",
            "name": "<h5>HOST FILE SYSTEM EXPORTS</h5><p>YES3 Exporter II can export to the host file system, n.b. to automounts pointing to secure institutional file shares. This will require services from your REDCap host system administrator, and the blessing of your Information Security Officer.</p>"
        },
        {
            "key": "enable-host-filesystem-exports",
            "name": "Enable export to host file system",
            "type": "checkbox",
            "required": true,
            "super-users-only": true
        },
        {
            "key": "export-target-folder",
            "name": "Host file system folder",
            "type": "textarea",
            "super-users-only": true,
            "required": true,
            "branchingLogic": {
                "field": "enable-host-filesystem-exports",
                "value": 1
            }
        },
        {
            "key": "enable-cron-batch-exports-info",
            "type" : "descriptive",
            "name": "<h5>ENABLE BATCH EXPORTS</h5><p>You may enable automated batch exports. If you do, each export for which you have checked 'Include in batch export' will be run as part of the nightly Exporter cron job.</p>"
        },
        {
            "key": "enable-cron-batch-exports",
            "name": "Enable automated (cron) batch exports",
            "required": true,
            "super-users-only": true,
            "type": "checkbox",
            "branchingLogic": {
                "field": "enable-host-filesystem-exports",
                "value": 1
            }
        },
        {
            "key": "enable-user-data-downloads-info",
            "type" : "descriptive",
            "name": "<h5>ALLOW USER DOWNLOADS</h5><p>You have enabled direct exports to your file system, but you may elect to allow user downloads as well. For security reasons we recommend that you do not allow user downloads in addition to filesystem exports.</p>",
            "branchingLogic": {
                "field": "enable-host-filesystem-exports",
                "value": 1
            }
        },
        {
            "key": "enable-user-data-downloads",
            "name": "Allow user downloads in addition to filesystem exports",
            "type": "checkbox",
            "super-users-only": true,
            "required": true,
            "branchingLogic": {
                "field": "enable-host-filesystem-exports",
                "value": 1
            }
        },
        {
            "key": "cron-user-info",
            "type" : "descriptive",
            "name": "<h5>CRON USER</h5><p>You must designate a user on your team as the 'cron user'. Batch exports will be run under this user's permissions, just as if she or he were signed in. Daily email notifications, if elected, will be sent to this user.</p>",
            "branchingLogic": {
                "type": "or",
                "conditions": [
                    {
                        "field": "notification-email-enable",
                        "value": 1
                    },
                    {
                        "field": "enable-cron-batch-exports",
                        "value": 1
                    }
                ]
            }
        },
        {
            "key": "cron-user",
            "name": "Cron user",
            "required": true,
            "type": "user-list",
            "branchingLogic": {
                "type": "or",
                "conditions": [
                    {
                        "field": "notification-email-enable",
                        "value": 1
                    },
                    {
                        "field": "enable-cron-batch-exports",
                        "value": 1
                    }
                ]
            }
        },
        {
            "key":   "project-cron-header",
            "type" : "descriptive",
            "name":  "<h5>CRON LOG</h5><p>The YES3 Exporter II perfoms a number daily tasks for each project. Below is the most recent daily cron log for this project.</p>"
        },
        {
            "key": "project-cron-log",
            "name": "Cron log for this project",
            "type": "textarea",
            "required": false
        },
        {
            "key":   "filetype-header",
            "type" : "descriptive",
            "name":  "<h5>EXPORT FILE TYPE</h5><p>By default, the export file type is tab-separated-values (TSV). If you like, you can change the export file type to comma-separated-values (CSV) instead. Note that TSV is generally more 'bullet proof' when it comes to handling special characters and line breaks.</p>"
        },
        {
            "key": "export-filetype-csv",
            "name": "Export files in CSV format",
            "type": "checkbox",
            "required": false
        },
        {
            "key":   "sascode-header",
            "type" : "descriptive",
            "name":  "<h5>SAS CODE GENERATION</h5><p>Your exports can be accompanied by execution-ready SAS code. In this section you may enter defaults for information required by the SAS code generator. These defaults may be overriden for any given export specification.</p><p>Note for Windows users: You must escape backslashes in file paths, i.e. (Z:\\\\mypath\\\\sascode) instead of (Z:\\mypath\\sascode).</p>"
        },
        {
            "key": "sascode-libref",
            "name": "SAS libref (1-8 character library name; typically a shortened version of your project name)",
            "required": false,
            "super-users-only": false,
            "type": "text"
        },
        {
            "key": "sascode-libref-path",
            "name": "SAS library path (full path to the directory where the SAS datasets will be written)",
            "required": false,
            "super-users-only": false,
            "type": "textarea"
        },
        {
            "key": "enable-validator-header",
            "type" : "descriptive",
            "super-users-only": false,
            "name": "<h5>VALIDATOR</h5><p>YES3 Exporter II includes a built-in export validator, that will compare any exported datasheet with the source REDCap data. The validator will check for and report discrepancies in order to ensure data integrity.</p><p>The validator can also be used to report any changes to REDCap data since the datasheet was exported.</p>"
        },
        {
            "key": "enable-validator",
            "name": "Enable the validator",
            "super-users-only": false,
            "type": "checkbox"
        },
        {
            "key":   "backup-retention-header",
            "type" : "descriptive",
            "name":  "<h5>BACKUP RETENTION</h5><p>By default, 20 generations of each export specification are retained, and can be restored using the 'undo' feature. You may change this number, or elect to retain all generations.</p>"
        },
        {
            "key": "export-spec-backup-retention",
            "name": "Specification backups to retain (default is 20)",
            "type": "dropdown",
            "choices": [
                {"name":"20",  "value":"20"},
                {"name":"40",  "value":"40"},
                {"name":"60",  "value":"60"},
                {"name":"80",  "value":"80"},
                {"name":"100", "value":"100"},
                {"name":"retain all backups",  "value":"all"}
            ],
            "required": false
        },
        {
            "key": "legacy-transfer-status",
            "name": "Legacy YES3 Exporter transfer status (nolegacy/pending/transferred/declined)",
            "type": "text",
            "required": false
        }
    ],

    "crons":[
        {
            "cron_name": "yes3_exporter_cron",
            "cron_description": "YES3 Exporter II cron manager",
            "method": "yes3_exporter_cron",
            "cron_frequency": "60",
            "cron_max_run_time": "60"
        }
    ],

    "no-auth-pages": [
    ],

    "auth-ajax-actions": [ "legacy-transfer", "no-legacy-transfer" ],

    "compatibility": {
    "php-version-min": "8.1",
    "php-version-max": "8.99",
    "redcap-version-min": "15.0.0"
    },

    "framework-version": 15
}